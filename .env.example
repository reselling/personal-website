# Last.fm - get your API key at https://www.last.fm/api/account/create
LASTFM_API_KEY=
LASTFM_USERNAME=

# Trakt - check your existing app and Client ID at https://developer.trakt.tv/apps
# A 403 indicates an invalid Client ID or unapproved app. Do not use Client Secret.
TRAKT_CLIENT_ID=
TRAKT_USERNAME=

# TMDB - get your API key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Hardcover - get your token from your Hardcover account settings
HARDCOVER_API_TOKEN=
HARDCOVER_USERNAME=

# PostHog: public, write-only project token from project settings, not a personal API key.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
